ENMOTION_ENV=production
ENMOTION_DATABASE_URL=sqlite:////var/lib/enmotion-control/control.db
# Generate at least 32 random characters. Never commit the real value.
ENMOTION_SESSION_HMAC_SECRET=replace-with-a-long-random-secret
ENMOTION_COOKIE_SECURE=true
ENMOTION_ACCESS_TTL_SECONDS=900
ENMOTION_REFRESH_TTL_SECONDS=604800
ENMOTION_MAX_REQUEST_BODY_BYTES=41943040

ENMOTION_PROVIDER_BASE_URL=https://provider.example.com/v1
# Exact model-to-secret mapping; the service rejects unknown model IDs.
ENMOTION_PROVIDER_CREDENTIALS_JSON='{"deepseek-v4-flash":"replace-me"}'

ENMOTION_RELEASE_MANIFEST_PATH=/etc/enmotion-control/releases.json
ENMOTION_RELEASE_ALLOWED_HOSTS=github.com,release-assets.githubusercontent.com,objects.githubusercontent.com
ENMOTION_RELEASE_SOURCE_CREDENTIALS_JSON='{}'
ENMOTION_PUBLIC_BASE_URL=https://accounts.example.com
ENMOTION_RELEASE_SESSION_TTL_SECONDS=7200

ENMOTION_BACKUP_DIR=/var/backups/enmotion-control
ENMOTION_BACKUP_AGE_RECIPIENT=age1replace_with_offsite_backup_recipient
ENMOTION_BACKUP_RETENTION=14
