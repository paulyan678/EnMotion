# Managed desktop mode
ENMOTION_HYBRID_MODE=true
ENMOTION_CONTROL_PLANE_URL=https://accounts.example.com

# Optional development overrides. Production desktop builds resolve the
# operating system's application-data and Documents locations automatically.
# ENMOTION_DATA_DIR=/absolute/private/app-data
# ENMOTION_OUTPUT_DIR=/absolute/user-visible/enmotion-output

# The Tauri parent supplies a fresh random value on every launch.
# Do not persist or commit a production nonce.
ENMOTION_SIDECAR_NONCE=development-only-random-value

# Local sidecar
API_HOST=127.0.0.1
API_PORT=0

# Desktop diagnostics remain loopback-only by default.
ENMOTION_ENABLE_REMOTE_DIAGNOSTICS=false

# Company provider credentials belong only in control_plane/.env. They are
# intentionally absent from this desktop example.
