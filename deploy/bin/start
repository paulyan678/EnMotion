#!/bin/sh
set -eu

mode=${ENMOTION_DEPLOY_MODE:-mac}
env_file=${ENMOTION_ENV_FILE:-}
build=false

while [ "$#" -gt 0 ]; do
    case "$1" in
        --mode) [ "$#" -ge 2 ] || exit 2; mode=$2; shift 2 ;;
        --env-file) [ "$#" -ge 2 ] || exit 2; env_file=$2; shift 2 ;;
        --build) build=true; shift ;;
        -h|--help)
            printf 'Usage: deploy/bin/start [--mode mac|production] [--env-file PATH] [--build]\n'
            exit 0
            ;;
        *) exit 2 ;;
    esac
done

export ENMOTION_DEPLOY_MODE=$mode
[ -z "$env_file" ] || export ENMOTION_ENV_FILE=$env_file
. "$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)/_lib.sh"

require_command docker
check_compose_version
lock_dir=$DEPLOY_DIR/.lifecycle.lock
acquire_lock "$lock_dir" start
cleanup() {
    exit_code=$?
    trap - EXIT INT TERM
    release_lock "$lock_dir"
    exit "$exit_code"
}
trap cleanup EXIT INT TERM
validate_env
compose config --quiet

if [ "$build" = true ]; then
    compose build
fi

compose up -d --wait database redis
compose --profile tools run --rm migrate check-database-compatibility
compose --profile tools run --rm migrate
compose --profile tools run --rm migrate check-database-compatibility --require-head
compose up -d --remove-orphans --wait

if [ "$DEPLOY_MODE" = mac ]; then
    info "running at http://127.0.0.1:$(env_value ENMOTION_HTTP_PORT)"
else
    info "running at https://$(env_value ENMOTION_DOMAIN)"
fi
