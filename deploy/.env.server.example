# Portable deployment identity. Keep the project name stable across backup and
# restore operations on one host. The application version is an image tag.
ENMOTION_COMPOSE_PROJECT_NAME=enmotion-web
ENMOTION_VERSION=0.1.0

# Bootstrap replaces both __GENERATE__ values with cryptographically random
# hex strings. Database passwords must remain URL-safe because DATABASE_URL is
# assembled by Compose. Never commit the generated deploy/.env.server file.
POSTGRES_DB=enmotion
POSTGRES_USER=enmotion
POSTGRES_PASSWORD=__GENERATE__
ENMOTION_SESSION_SECRET=__GENERATE__

# Mac mode listens only on loopback by default.
ENMOTION_BIND_HOST=127.0.0.1
ENMOTION_HTTP_PORT=8080
ENMOTION_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
ENMOTION_COOKIE_SECURE=false

# Production mode: set a real DNS name, change the bind host to 0.0.0.0, use
# an https origin, and leave TLS termination to the bundled Caddy edge.
ENMOTION_DOMAIN=example.com
# ENMOTION_BIND_HOST=0.0.0.0
# ENMOTION_ALLOWED_ORIGINS=https://example.com
# ENMOTION_COOKIE_SECURE=true

# Authentication controls.
ENMOTION_SESSION_COOKIE_NAME=enmotion_session
# The CSRF cookie/header names are a fixed frontend/API protocol and are not configurable.
ENMOTION_SESSION_TTL_SECONDS=604800
# Successful logins prune expired/revoked rows and keep at most this many
# concurrently active sessions per account.
ENMOTION_MAX_ACTIVE_SESSIONS_PER_USER=20
# Per-IP failures use the lower threshold; distributed failures against one
# known username use this higher threshold to resist targeted account lockout.
ENMOTION_LOGIN_ATTEMPTS=5
ENMOTION_LOGIN_ACCOUNT_ATTEMPTS=25
ENMOTION_LOGIN_WINDOW_SECONDS=300

# Durable queue contract. Change only when using a compatible worker module.
ENMOTION_WORKER_COMMAND=python -m src.apps.server.worker
ENMOTION_MAX_ACTIVE_JOBS_PER_WORKSPACE=10
ENMOTION_MAX_DAILY_JOBS_PER_WORKSPACE=100
ENMOTION_MAX_JOBS_PER_REQUEST=10
# Serialized durable-job metadata is stored in PostgreSQL and does not count
# toward media quota, so keep this bound small enough to protect database disk.
ENMOTION_MAX_JOB_PAYLOAD_BYTES=262144
ENMOTION_JOB_STORAGE_RESERVATION_BYTES=536870912
ENMOTION_VIDEO_JOB_STORAGE_RESERVATION_BYTES=1073741824
ENMOTION_BATCH_JOB_STORAGE_RESERVATION_BYTES=4294967296
# Full-storyboard/video, merge, and export operations may create large outputs.
ENMOTION_LONG_MEDIA_JOB_STORAGE_RESERVATION_BYTES=4294967296
ENMOTION_MAX_JOB_STORAGE_RESERVATION_BYTES=4294967296
# A completed handler is failed if its actual output delta crosses this hard cap.
ENMOTION_MAX_JOB_OUTPUT_BYTES=4294967296
# Crash recovery: fail unpublished reservations after this age, and retry only
# Redis publications whose durable confirmation was interrupted.
ENMOTION_JOB_RESERVATION_TTL_SECONDS=300
ENMOTION_QUEUE_RECONCILE_INTERVAL_SECONDS=30
# Terminal DB commits are retried without re-running providers, then recovered
# from a private app-data outbox if PostgreSQL remains unavailable.
ENMOTION_JOB_FINALIZE_ATTEMPTS=5
ENMOTION_JOB_FINALIZE_RETRY_DELAY_MS=200
ENMOTION_JOB_TERMINAL_RECONCILE_BATCH=100
# Keep recent history for the UI while bounding PostgreSQL growth. Active jobs
# and every terminal job from the last 24 hours are never compacted.
ENMOTION_JOB_HISTORY_RETENTION_DAYS=30
ENMOTION_MAX_TERMINAL_JOBS_PER_WORKSPACE=500
ENMOTION_JOB_COMPACTION_BATCH_SIZE=1000

# User-supplied and provider-returned media is fetched only from these exact
# hosts or wildcard subdomains. Keep this narrow. Add the CDN host shown in a
# failed generation response if your New API relay uses a separate result CDN.
# Never use a catch-all such as "*.com".
ENMOTION_REMOTE_MEDIA_HOSTS=www.moyu.cn,*.moyu.cn,*.aliyuncs.com,*.tos-cn-beijing.volces.com
ENMOTION_REMOTE_IMAGE_MAX_BYTES=26214400
ENMOTION_REMOTE_MEDIA_MAX_BYTES=536870912
NEWAPI_VIDEO_POLL_INTERVAL=15
# Seedance jobs may remain queued or processing longer than 15 minutes.
NEWAPI_VIDEO_MAX_WAIT=3600
ENMOTION_WORKSPACE_LOCK_THREADS=8
# Edge and API request-body ceiling (16 MiB). Keep it above the application's
# per-file limits (5 MiB text, 8/10 MiB images, and 10 MiB audio uploads).
ENMOTION_MAX_REQUEST_BODY_BYTES=16777216

# Bound Docker json-file logs so a noisy service cannot fill the host disk.
ENMOTION_LOG_MAX_SIZE=10m
ENMOTION_LOG_MAX_FILES=5

# New API gateway and model selection. Add each model's own key. Blank values
# are accepted until that model is used; do not reuse one model's key for another.
NEWAPI_BASE_URL=https://www.moyu.cn/v1
NEWAPI_CHAT_MODEL=deepseek-v4-flash
NEWAPI_IMAGE_MODEL=gpt-image-2
NEWAPI_VIDEO_MODEL=doubao-seedance-2-0-fast-260128
NEWAPI_GPT_IMAGE_2_API_KEY=
NEWAPI_SEEDANCE_2_API_KEY=
NEWAPI_SEEDANCE_2_FAST_API_KEY=
NEWAPI_SEEDANCE_2_MINI_API_KEY=
NEWAPI_DEEPSEEK_V4_FLASH_API_KEY=
NEWAPI_QWEN_37_MAX_API_KEY=
NEWAPI_DEEPSEEK_V4_PRO_API_KEY=

# Optional Alibaba Cloud OSS media mirror.
OSS_ENABLE=false
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_BASE_PATH=comic_gen/

# Demucs downloads large model weights on first use unless preloading is enabled.
ENMOTION_PRELOAD_DEMUCS=0
